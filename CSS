/* Reset CSS cơ bản */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    background-color: #f4f4f4;
    color: #333;
}

/* Khung chứa toàn bộ trang web (Container) */
.container {
    width: 950px;
    margin: 20px auto;
    background-color: #ffffff;
    border: 1px solid #ccc;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

/* 1. Header */
header {
    background-color: #2c3e50;
    color: #ffffff;
    padding: 20px;
    text-align: center;
}

/* 2. Navigation (Thanh điều hướng) */
nav {
    background-color: #34495e;
    overflow: hidden;
}

nav ul {
    list-style: none;
}

nav ul li {
    float: left;
}

nav ul li a {
    display: block;
    color: white;
    text-align: center;
    padding: 12px 20px;
    text-decoration: none;
}

nav ul li a:hover {
    background-color: #1abc9c;
}

/* Clearfix cho Float trong Nav */
nav::after {
    content: "";
    display: table;
    clear: both;
}

/* Khu vực thân chứa Section và Aside */
.main-content {
    padding: 20px;
}

.main-content::after {
    content: "";
    display: table;
    clear: both;
}

/* 3. Section (Nội dung chính bên trái) */
section {
    float: left;
    width: 65%;
}

article {
    background-color: #ecf0f1;
    padding: 15px;
    margin-bottom: 20px;
    border-left: 5px solid #2980b9;
}

article h2 {
    color: #2c3e50;
    margin-bottom: 10px;
}

/* 4. Aside (Thanh bên phải) */
aside {
    float: right;
    width: 30%;
    background-color: #e8f8f5;
    padding: 15px;
    border: 1px solid #a3e4d7;
}

aside h3 {
    color: #16a085;
    margin-bottom: 10px;
}

aside ul {
    list-style-position: inside;
}

aside ul li {
    margin-bottom: 8px;
}

/* 5. Footer (Chân trang) */
footer {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 15px;
    clear: both;
    margin-top: 10px;
}
