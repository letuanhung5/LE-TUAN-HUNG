<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bootstrap Simple Gallery</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        /* Tùy chỉnh Media Queries theo đúng yêu cầu kích thước đề bài */

        /* Màn hình lớn (> 700px): Hiển thị 4 ảnh / hàng (chiếm 25% chiều rộng) */
        @media (min-width: 701px) {
            .gallery-col {
                flex: 0 0 auto;
                width: 25%;
            }
        }

        /* Màn hình vừa (501px - 700px): Hiển thị 2 ảnh / hàng (chiếm 50% chiều rộng) */
        @media (max-width: 700px) and (min-width: 501px) {
            .gallery-col {
                flex: 0 0 auto;
                width: 50%;
            }
        }

        /* Màn hình nhỏ (<= 500px): Hiển thị 1 ảnh / hàng (chiếm 100% chiều rộng) */
        @media (max-width: 500px) {
            .gallery-col {
                flex: 0 0 auto;
                width: 100%;
            }
        }

        /* Style trang trí thêm cho khung ảnh đẹp mắt */
        .gallery-card {
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 5px;
            background-color: #fff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .gallery-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        }

        .gallery-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 2px;
        }

        .desc {
            padding: 10px;
            text-align: center;
            font-size: 14px;
            color: #555;
        }
    </style>
</head>
<body class="bg-light">

    <div class="container my-5">
        <h2 class="text-center mb-4">Responsive Image Gallery</h2>
        
        <!-- Lưới Gallery sử dụng Bootstrap Row kết hợp Class Custom -->
        <div class="row g-3">
            
            <!-- Ảnh 1 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=1" alt="Cinque Terre">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

            <!-- Ảnh 2 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=2" alt="Forest">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

            <!-- Ảnh 3 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=3" alt="Northern Lights">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

            <!-- Ảnh 4 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=4" alt="Mountains">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

            <!-- Ảnh 5 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=5" alt="Nature">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

            <!-- Ảnh 6 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=6" alt="City">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

            <!-- Ảnh 7 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=7" alt="Ocean">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

            <!-- Ảnh 8 -->
            <div class="gallery-col">
                <div class="gallery-card">
                    <img src="https://picsum.photos/400/300?random=8" alt="Desert">
                    <div class="desc">Add a description of the image here</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
