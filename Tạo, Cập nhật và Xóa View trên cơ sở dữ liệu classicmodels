-- Chuyển sang cơ sở dữ liệu classicmodels
USE classicmodels;

-- 1. Tạo View có tên customer_views lấy thông tin customerNumber, customerName, phone
CREATE VIEW customer_views AS
SELECT customerNumber, customerName, phone
FROM customers;

-- Truy vấn dữ liệu từ bảng ảo (View) vừa tạo
SELECT * FROM customer_views;


-- 2. Cập nhật (sửa) View customer_views bằng CREATE OR REPLACE VIEW
-- Thêm các cột contactFirstName, contactLastName và lọc khách hàng ở thành phố Nantes
CREATE OR REPLACE VIEW customer_views AS
SELECT customerNumber, customerName, contactFirstName, contactLastName, phone
FROM customers
WHERE city = 'Nantes';

-- Truy vấn kiểm tra lại View sau khi cập nhật
SELECT * FROM customer_views;


-- 3. Xóa View khi không còn sử dụng
DROP VIEW customer_views;
