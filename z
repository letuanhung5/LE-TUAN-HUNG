/* Import font chữ Google Fonts (Roboto) */
@import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,700;1,400&display=swap');

body {
    font-family: 'Roboto', Arial, sans-serif;
    line-height: 1.6;
    background-color: #f4f6f8;
    color: #333333;
    padding: 30px;
}

.container {
    max-width: 800px;
    margin: 0 auto;
    background-color: #ffffff;
    padding: 40px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

/* 1. Định dạng Tiêu đề chính */
h1.main-title {
    color: #1a237e;               /* Màu xanh navy đậm */
    font-size: 28px;               /* Kích thước chữ */
    text-align: center;            /* Căn giữa tiêu đề */
    text-transform: uppercase;     /* Viết hoa toàn bộ */
    letter-spacing: 2px;           /* Khoảng cách giữa các chữ cái */
    margin-bottom: 25px;
    border-bottom: 2px solid #1a237e;
    padding-bottom: 10px;
}

/* 2. Định dạng Trích dẫn / Mở đầu */
p.intro {
    font-style: italic;            /* Chữ nghiêng */
    color: #555555;                /* Màu xám trung tính */
    font-size: 18px;
    text-align: justify;           /* Căn đều 2 bên */
    background-color: #e8eaf6;
    padding: 15px 20px;
    border-left: 5px solid #3f51b5;
    margin-bottom: 25px;
}

/* 3. Định dạng Đoạn văn bản chính */
p.content {
    font-size: 16px;
    color: #212121;
    text-align: justify;           /* Căn đều hai bên */
    text-indent: 30px;             /* Thụt lùi đầu dòng 30px (text-indent) */
    line-height: 1.8;              /* Khoảng cách dòng */
    margin-bottom: 15px;
}

/* 4. Định dạng Nhấn mạnh nội dung */
.highlight {
    color: #d32f2f;                /* Màu đỏ nổi bật */
    font-weight: bold;             /* Chữ in đậm */
    text-decoration: underline;    /* Gạch chân văn bản */
}

/* 5. Định dạng Tác giả / Chân trang */
p.author {
    text-align: right;             /* Căn phải */
    font-weight: bold;
    font-size: 16px;
    color: #1a237e;
    margin-top: 30px;
    font-style: italic;
}
