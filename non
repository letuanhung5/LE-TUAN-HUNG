-- Chuyển sang cơ sở dữ liệu classicmodels
USE classicmodels;

-- =========================================================
-- 1. THAM SỐ LOẠI IN
-- Lấy thông tin khách hàng theo mã số khách hàng (customerNumber)
-- =========================================================
DELIMITER //

DROP PROCEDURE IF EXISTS `getCusById`//

CREATE PROCEDURE getCusById(
    IN cusNum INT
)
BEGIN
    SELECT * FROM customers WHERE customerNumber = cusNum;
END //

DELIMITER ;

-- Gọi Stored Procedure với tham số IN = 175
CALL getCusById(175);


-- =========================================================
-- 2. THAM SỐ LOẠI OUT
-- Đếm số lượng khách hàng theo thành phố và trả về giá trị qua biến OUT
-- =========================================================
DELIMITER //

DROP PROCEDURE IF EXISTS `GetCustomersCountByCity`//

CREATE PROCEDURE GetCustomersCountByCity(
    IN in_city VARCHAR(50),
    OUT total INT
)
BEGIN
    SELECT COUNT(customerNumber)
    INTO total
    FROM customers
    WHERE city = in_city;
END //

DELIMITER ;

-- Gọi Stored Procedure với thành phố 'Lyon' và nhận kết quả vào biến @total
CALL GetCustomersCountByCity('Lyon', @total);

-- Hiển thị kết quả của biến @total
SELECT @total;


-- =========================================================
-- 3. THAM SỐ LOẠI INOUT
-- Tăng giá trị của biến đếm dựa trên giá trị cộng thêm truyền vào
-- =========================================================
DELIMITER //

DROP PROCEDURE IF EXISTS `SetCounter`//

CREATE PROCEDURE SetCounter(
    INOUT counter INT,
    IN inc INT
)
BEGIN
    SET counter = counter + inc;
END //

DELIMITER ;

-- Khởi tạo biến @counter với giá trị ban đầu là 1
SET @counter = 1;

-- Gọi thủ tục lần 1: @counter = 1 + 1 = 2
CALL SetCounter(@counter, 1);

-- Gọi thủ tục lần 2: @counter = 2 + 1 = 3
CALL SetCounter(@counter, 1);

-- Gọi thủ tục lần 3: @counter = 3 + 5 = 8
CALL SetCounter(@counter, 5);

-- Hiển thị kết quả cuối cùng của biến @counter (kết quả là 8)
SELECT @counter;
