<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Microsoft Surface - Landing Page</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        /* CSS tùy chỉnh tối thiểu cho tỷ lệ ảnh hero và hover */
        .hero-section {
            background-color: #f2f2f2;
        }
        .card-img-top {
            height: 220px;
            object-fit: cover;
        }
    </style>
</head>
<body>

    <!-- 1. NAVBAR (THANH ĐIỀU HƯỚNG) -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="#">
                <i class="bi bi-microsoft me-2"></i>Microsoft Surface
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link active" href="#">Computers</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Computers 2-in-1</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Dual-screen</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Accessories</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Deals</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <a href="#" class="text-dark text-decoration-none small">All Microsoft</a>
                    <a href="#" class="text-dark"><i class="bi bi-search"></i></a>
                    <a href="#" class="text-dark"><i class="bi bi-cart"></i></a>
                    <a href="#" class="text-dark"><i class="bi bi-person-circle fs-5"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- 2. HERO BANNER -->
    <section class="hero-section py-5 mb-5">
        <div class="container">
            <div class="row align-items-center flex-column-reverse flex-lg-row g-4">
                <div class="col-lg-6">
                    <span class="badge bg-primary mb-2 px-3 py-2">New Release</span>
                    <h1 class="display-4 fw-bold mb-3">Surface Pro 9</h1>
                    <p class="lead text-muted mb-4">
                        The tablet versatility you want and the laptop performance you need—all in one ultra-portable device.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="btn btn-primary btn-lg px-4">Shop Surface Pro 9</a>
                        <a href="#" class="btn btn-outline-dark btn-lg px-4">Learn More</a>
                    </div>
                </div>
                <div class="col-lg-6 text-center">
                    <img src="https://picsum.photos/800/500?random=10" class="img-fluid rounded-3 shadow-sm" alt="Surface Pro 9">
                </div>
            </div>
        </div>
    </section>

    <!-- 3. FEATURED PRODUCTS (DANH SÁCH SẢN PHẨM NỔI BẬT) -->
    <section class="container mb-5">
        <h2 class="fw-bold mb-4">Explore the Surface lineup</h2>
        <div class="row g-4">
            
            <!-- Product Card 1 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="https://picsum.photos/400/300?random=1" class="card-img-top" alt="Surface Laptop 5">
                    <div class="card-body d-flex flex-column">
                        <span class="text-muted small mb-1">Laptop</span>
                        <h5 class="card-title fw-bold">Surface Laptop 5</h5>
                        <p class="card-text text-secondary flex-grow-1">Blazing-fast speed, sophisticated style, and all-day battery life.</p>
                        <div class="mt-3">
                            <p class="fw-bold text-dark mb-2">From $999.99</p>
                            <a href="#" class="btn btn-outline-primary w-100">Shop now</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Card 2 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="https://picsum.photos/400/300?random=2" class="card-img-top" alt="Surface Laptop Studio">
                    <div class="card-body d-flex flex-column">
                        <span class="text-muted small mb-1">Creative Powerhouse</span>
                        <h5 class="card-title fw-bold">Surface Laptop Studio</h5>
                        <p class="card-text text-secondary flex-grow-1">Incredibly powerful, infinitely flexible device for creators.</p>
                        <div class="mt-3">
                            <p class="fw-bold text-dark mb-2">From $1,599.99</p>
                            <a href="#" class="btn btn-outline-primary w-100">Shop now</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Card 3 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="https://picsum.photos/400/300?random=3" class="card-img-top" alt="Surface Laptop Go 2">
                    <div class="card-body d-flex flex-column">
                        <span class="text-muted small mb-1">Everyday Everyday</span>
                        <h5 class="card-title fw-bold">Surface Laptop Go 2</h5>
                        <p class="card-text text-secondary flex-grow-1">Sleek and portable touchscreen laptop for daily essential tasks.</p>
                        <div class="mt-3">
                            <p class="fw-bold text-dark mb-2">From $599.99</p>
                            <a href="#" class="btn btn-outline-primary w-100">Shop now</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Card 4 -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="https://picsum.photos/400/300?random=4" class="card-img-top" alt="Surface Studio 2+">
                    <div class="card-body d-flex flex-column">
                        <span class="text-muted small mb-1">All-in-One Desktop</span>
                        <h5 class="card-title fw-bold">Surface Studio 2+</h5>
                        <p class="card-text text-secondary flex-grow-1">Sleek desktop with a vibrant 28-inch touchscreen for creative pros.</p>
                        <div class="mt-3">
                            <p class="fw-bold text-dark mb-2">From $4,299.99</p>
                            <a href="#" class="btn btn-outline-primary w-100">Shop now</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- 4. SECONDARY BANNER (BĂNG CỜ PHỤ) -->
    <section class="bg-dark text-white py-5 mb-5">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-6 text-center">
                    <img src="https://picsum.photos/700/400?random=5" class="img-fluid rounded-3" alt="Surface Accessories">
                </div>
                <div class="col-lg-6">
                    <h2 class="display-6 fw-bold mb-3">Designed for Microsoft Surface</h2>
                    <p class="lead text-light opacity-75 mb-4">
                        Complete your experience with Surface Slim Pen 2, Surface Pro Signature Keyboard, headphones, mice, and more.
                    </p>
                    <a href="#" class="btn btn-light btn-lg">Explore Accessories</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. FOOTER (CHÂN TRANG) -->
    <footer class="bg-light pt-5 pb-4 border-top">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-6 col-md-2">
                    <h6 class="fw-bold mb-3">What's new</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Surface Pro 9</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Surface Laptop 5</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Surface Studio 2+</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="fw-bold mb-3">Microsoft Store</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Account profile</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Download Center</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Returns</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="fw-bold mb-3">Education</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Microsoft in education</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Devices for education</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="fw-bold mb-3">Business</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Microsoft Cloud</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Surface for Business</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="fw-bold mb-3">Developer</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Microsoft Visual Studio</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Developer Center</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="fw-bold mb-3">Company</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Careers</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">About Microsoft</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-3 border-top small text-muted">
                <p class="mb-2 mb-md-0">&copy; Microsoft 2026. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-decoration-none text-muted">Privacy</a>
                    <a href="#" class="text-decoration-none text-muted">Terms of Use</a>
                    <a href="#" class="text-decoration-none text-muted">Trademarks</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
