/* Custom Reset & Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Roboto:wght@400;500;700&display=swap');

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Merriweather', Georgia, serif;
    line-height: 1.8;
    background-color: #f8f6f0; /* Màu nền giấy đọc sách nhẹ mắt */
    color: #2c2c2c;
    padding: 20px 10px;
}

.container {
    max-width: 800px;
    margin: 0 auto;
    background-color: #ffffff;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

/* Bước 4: Ảnh truyện ở đầu trang */
.header-cover {
    text-align: center;
    margin-bottom: 30px;
}

.header-cover img {
    width: 100%;
    max-height: 380px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
}

.book-title {
    font-family: 'Roboto', sans-serif;
    font-size: 32px;
    color: #1b365d;
    text-align: center;
    margin-top: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.book-author {
    text-align: center;
    font-style: italic;
    color: #666;
    margin-bottom: 30px;
}

/* Bước 1 & 5: Khu vực mục lục dùng thẻ <h5> */
.table-of-contents {
    background-color: #f0f4f8;
    border-left: 5px solid #1b365d;
    padding: 20px 25px;
    border-radius: 6px;
    margin-bottom: 40px;
}

.toc-title {
    font-family: 'Roboto', sans-serif;
    font-size: 18px;
    color: #1b365d;
    margin-bottom: 15px;
    text-transform: uppercase;
}

.table-of-contents ul {
    list-style-type: none;
}

.table-of-contents li {
    margin-bottom: 10px;
}

/* Thẻ h5 cho từng mục lục truyện */
.table-of-contents h5 {
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    font-weight: 500;
}

/* Bước 3: Liên kết chuyển động mượt tới chương tương ứng */
.table-of-contents a {
    color: #0d6efd;
    text-decoration: none;
    transition: color 0.2s ease, text-decoration 0.2s ease;
}

.table-of-contents a:hover {
    color: #0b5ed7;
    text-decoration: underline;
}

/* Cuộn trang mượt khi click liên kết */
html {
    scroll-behavior: smooth;
}

/* Bước 2: Nội dung truyện */
.chapter {
    margin-bottom: 40px;
    padding-top: 20px;
    border-top: 1px dashed #ddd;
}

.chapter-title {
    font-family: 'Roboto', sans-serif;
    font-size: 22px;
    color: #1b365d;
    margin-bottom: 15px;
}

.chapter p {
    font-size: 17px;
    text-align: justify;
    text-indent: 30px;
    margin-bottom: 15px;
    color: #333;
}

/* Nút quay lại mục lục */
.back-to-top {
    display: inline-block;
    font-family: 'Roboto', sans-serif;
    font-size: 13px;
    color: #6c757d;
    text-decoration: none;
    margin-top: 10px;
}

.back-to-top:hover {
    color: #1b365d;
}
